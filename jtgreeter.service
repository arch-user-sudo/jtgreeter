[Unit]
Description=JTLab Greeter (Wayland login screen)
Wants=systemd-logind.service
After=systemd-logind.service systemd-user-sessions.service plymouth-quit-wait.service
Conflicts=getty@tty1.service autovt@tty1.service
Before=getty@tty1.service autovt@tty1.service

[Service]
Type=simple
Environment=XDG_RUNTIME_DIR=/run/user/0
# Runtime conflict handling (avoid persistent system config changes).
ExecStartPre=+/bin/sh -c 'mkdir -p /run/user/0 && chown root:root /run/user/0 && chmod 0700 /run/user/0'
ExecStartPre=-/bin/sh -c 'systemctl stop getty@tty1.service autovt@tty1.service 2>/dev/null || true; sleep 0.2'
ExecStart=@BINDIR@/jtgreeter
Restart=on-failure
RestartSec=2

# Run on tty1 as a login greeter/compositor
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal

PAMName=jtgreeter
UtmpIdentifier=tty1
UtmpMode=user

[Install]
WantedBy=graphical.target
Alias=display-manager.service
WantedBy=multi-user.target
