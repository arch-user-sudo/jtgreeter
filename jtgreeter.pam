#%PAM-1.0
# Self-contained fallback stack for jtgreeter (login greeter).
# Installed only when no known distro stack is detected, so it must not
# include another stack (such as "login") that may not exist.
auth       required   pam_unix.so
account    required   pam_unix.so
password   required   pam_unix.so
session    required   pam_unix.so
